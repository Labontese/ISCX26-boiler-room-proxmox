[Unit]
Description=Arkivera Windows Server Backup från SRV-01-DC varje morgon

[Timer]
# Windows Server Backup startar 03:00. Arkiveringen körs 07:00, så att även en
# långsam backup hinner bli klar. Skriptet stoppar själv om backupen pågår.
OnCalendar=*-*-* 07:00:00
# Missad körning, till exempel efter omstart, tas direkt när servern är uppe.
Persistent=true

[Install]
WantedBy=timers.target
